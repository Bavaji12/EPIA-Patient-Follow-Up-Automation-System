# EPIA Patient Follow-Up Automation System Environment Variables

# Backend Server Port
PORT=5000

# SQLite Database File Path (Optional, defaults to backend/database/epia.db)
# DATABASE_PATH=./database/epia.db

# Google Gemini API Key
# If omitted or left as placeholder, the system seamlessly uses Mock AI fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Environment Mode
NODE_ENV=development

